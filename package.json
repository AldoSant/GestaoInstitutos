{
  "name": "instituto-folha",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate": "npm run lint && npm run typecheck && npm test && npm run db:check && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:bootstrap:empresa": "tsx scripts/db/bootstrap-empresa.ts",
    "db:bootstrap:regras": "tsx scripts/db/bootstrap-regras.ts",
    "db:bootstrap:enquadramento": "tsx scripts/db/bootstrap-enquadramento.ts",
    "db:smoke:folha": "tsx scripts/db/smoke-folha.ts",
    "db:smoke:folha-consolidada": "tsx scripts/db/smoke-folha-consolidada.ts",
    "worker:start": "tsx scripts/worker/executar.ts",
    "worker:validar-regra": "tsx scripts/worker/enfileirar-validacao.ts",
    "giw:coletar:pessoas": "node scripts/giw/coletar-pessoas.mjs",
    "giw:coletar:cadastros": "node scripts/giw/coletar-cadastros-base.mjs",
    "giw:coletar:eventos": "node scripts/giw/coletar-eventos.mjs",
    "giw:coletar:instrumentos": "node scripts/giw/coletar-instrumentos.mjs",
    "giw:mapear:historico": "node scripts/giw/mapear-historico.mjs",
    "giw:inventariar:insumos": "tsx scripts/importacao/inventariar-insumos.ts",
    "giw:importar:lote": "tsx scripts/importacao/importar-lote.ts",
    "giw:reconciliar:historico": "tsx scripts/importacao/reconciliar-historico.ts",
    "giw:converter:historico": "tsx scripts/importacao/converter-historico-csv.ts",
    "giw:converter:historico-pdf": "tsx scripts/importacao/converter-historico-pdf.ts",
    "giw:importar": "tsx scripts/importacao/importar.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.468.0",
    "next": "16.2.11",
    "pg": "8.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  },
  "type": "module"
}
